  "item": [
    {
      "name": "Create Student Profile.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 or 200\", function () {",
              "    pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test(\"Response contains a profile ID\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:3000/api/profiles/1",
          "protocol": "http",
          "host": [
            "127",
            "0",
            "0",
            "1"
          ],
          "port": "3000",
          "path": [
            "api",
            "profiles",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Alice Martin\",\r\n  \"year\": 4,\r\n  \"major\": \"Data Science and AI\",\r\n  \"bio\": \"Engineering student interested in machine learning.\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
