
{
  "info": {
    "name": "STUD-8 - Reset Password",
    "description": "Postman tests for the StudyMatch password reset API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "STUD-8 - Forgot Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"unknown@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/forgot-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "forgot-password"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains confirmation message', function () {",
              "    pm.expect(pm.response.json().message).to.eql(",
              "        'If this email exists, a reset link will be sent.'",
              "    );",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "STUD-8 - Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"invalid-token\",\n  \"newPassword\": \"NewPassword123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/api/auth/reset-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "auth", "reset-password"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Invalid token is rejected', function () {",
              "    pm.expect(pm.response.json().error).to.eql(",
              "        'Invalid or expired reset link'",
              "    );",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
